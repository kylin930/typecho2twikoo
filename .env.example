# Copy to .env locally. Never commit .env or paste credentials in chat.
# Prefer the exact official Atlas standard URI when SRV DNS is unavailable.
MONGODB_URI=
# Required for writes; use the real deployment database, not a guessed name.
MONGODB_DATABASE=
MONGODB_COLLECTION=comment
MONGODB_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=5
# Optional trusted CA bundle. Certificate and hostname verification stay enabled.
MONGODB_CA_FILE=
